# Telegram bot tokeni (BotFather dan oling)
BOT_TOKEN=123456:ABC-YOUR-BOT-TOKEN

# Kanal ID (masalan -1001234567890). Bot kanalda admin bo'lishi shart.
CHANNEL_ID=-1001234567890

# Mini App ochiladigan URL (HTTPS bo'lishi shart, Telegram talabi).
# Lokalda ishlash uchun: ngrok yoki cloudflared tunneldan foydalaning.
WEB_APP_URL=https://your-domain.example

# Birinchi admin (siz)ning Telegram ID raqami. https://t.me/getmyid_bot dan oling.
OWNER_ID=123456789

# Server port
PORT=3000
